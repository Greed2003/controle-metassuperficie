cmake_minimum_required(VERSION 3.20)

if(NOT DEFINED ELF OR NOT EXISTS "${ELF}")
    message(FATAL_ERROR "Informe um ELF existente com -DELF=...")
endif()
if(DEFINED REPORT)
    file(REMOVE "${REPORT}")
endif()
find_program(AVR_OBJDUMP NAMES avr-objdump REQUIRED)
execute_process(
    COMMAND "${AVR_OBJDUMP}" -f -h -t -C "${ELF}"
    RESULT_VARIABLE result
    OUTPUT_VARIABLE inspection
    ERROR_VARIABLE error
)
if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Falha ao inspecionar o firmware: ${error}")
endif()
if(NOT inspection MATCHES "file format elf32-avr" OR
   NOT inspection MATCHES "architecture: avr:6," OR
   NOT inspection MATCHES "EXEC_P")
    message(FATAL_ERROR "O firmware deve ser um executavel ELF para avr:6.")
endif()

set(flash_limit 253952)
set(sram_start 0x800200)
set(sram_total 8192)
set(stack_reserve 2048)
math(EXPR sram_limit "${sram_total} - ${stack_reserve}")
set(flash_end 0)
set(sram_used 0)
set(text_size 0)

string(REPLACE "\r" "" inspection "${inspection}")
string(REPLACE ";" "\\;" rows "${inspection}")
string(REPLACE "\n" ";" rows "${rows}")
foreach(line IN LISTS rows)
    if(line MATCHES "^[ \t]*[0-9]+[ \t]+(\\.[^ \t]+)[ \t]+([0-9a-fA-F]+)[ \t]+([0-9a-fA-F]+)[ \t]+([0-9a-fA-F]+)[ \t]+")
        set(section "${CMAKE_MATCH_1}")
        set(size_hex "${CMAKE_MATCH_2}")
        set(vma_hex "${CMAKE_MATCH_3}")
        set(lma_hex "${CMAKE_MATCH_4}")
        math(EXPR size "0x${size_hex}")
        math(EXPR vma "0x${vma_hex}")
        math(EXPR lma "0x${lma_hex}")
    elseif(DEFINED section)
        if(line MATCHES "ALLOC" AND size GREATER 0)
            if(section STREQUAL ".text")
                if(NOT vma EQUAL 0 OR NOT lma EQUAL 0 OR NOT line MATCHES "LOAD")
                    message(FATAL_ERROR "A secao .text deve iniciar em zero na Flash.")
                endif()
                set(text_size "${size}")
            elseif(NOT section MATCHES "^\\.(data|bss|noinit)$")
                message(FATAL_ERROR "Secao alocada nao prevista: ${section}")
            endif()
            if(section MATCHES "^\\.(text|data)$")
                if(NOT line MATCHES "LOAD")
                    message(FATAL_ERROR "Secao sem imagem de carga: ${section}")
                endif()
                math(EXPR end "${lma} + ${size}")
                if(end GREATER flash_end)
                    set(flash_end "${end}")
                endif()
            endif()
            if(section MATCHES "^\\.(data|bss|noinit)$")
                if(vma LESS sram_start)
                    message(FATAL_ERROR "Secao fora da SRAM interna: ${section}")
                endif()
                math(EXPR used "${vma} + ${size} - ${sram_start}")
                if(used GREATER sram_used)
                    set(sram_used "${used}")
                endif()
            endif()
        endif()
        unset(section)
    endif()
endforeach()

if(text_size EQUAL 0 OR flash_end GREATER flash_limit)
    message(FATAL_ERROR "Flash invalida: ${flash_end} bytes; limite ${flash_limit}.")
endif()
if(sram_used GREATER sram_limit)
    message(FATAL_ERROR "SRAM estatica: ${sram_used} bytes; limite ${sram_limit}, reservando ${stack_reserve} para a pilha.")
endif()

string(REGEX MATCHALL
    "[^\n]*metasurface::\\(anonymous namespace\\)::kPatterns[^\n]*"
    catalogs "${inspection}")
list(LENGTH catalogs count)
if(NOT count EQUAL 1)
    message(FATAL_ERROR "Esperado um unico simbolo do catalogo no ELF.")
endif()
list(GET catalogs 0 catalog)
if(NOT catalog MATCHES "^([0-9a-fA-F]+)[ \t]+.*[ \t]O[ \t]+\\.text[ \t]+([0-9a-fA-F]+)[ \t]+metasurface::\\(anonymous namespace\\)::kPatterns$")
    message(FATAL_ERROR "O catalogo deve estar na secao .text da Flash: ${catalog}")
endif()
set(catalog_address "${CMAKE_MATCH_1}")
set(catalog_bytes "${CMAKE_MATCH_2}")
math(EXPR catalog_start "0x${catalog_address}")
math(EXPR catalog_size "0x${catalog_bytes}")
math(EXPR catalog_end "${catalog_start} + ${catalog_size}")
if(NOT catalog_size EQUAL 1536 OR catalog_end GREATER 65536 OR catalog_end GREATER text_size)
    message(FATAL_ERROR "Catalogo invalido: inicio ${catalog_start}, tamanho ${catalog_size}, fim exclusivo ${catalog_end}.")
endif()

math(EXPR sram_free "${sram_total} - ${sram_used}")
set(summary "Flash: ${flash_end}/${flash_limit} bytes\nSRAM estatica: ${sram_used}/${sram_total} bytes\nSRAM restante: ${sram_free} bytes; reserva minima para pilha: ${stack_reserve}\nCatalogo: ${catalog_size} bytes na Flash, intervalo [${catalog_start}, ${catalog_end}), abaixo de 64 KiB\n")
message(STATUS "${summary}")
if(DEFINED REPORT)
    file(WRITE "${REPORT}" "${summary}\n${inspection}")
endif()
